# ANNARAKSHAK Environment Variables
# Copy this to .env and modify as needed

# Database
DATABASE_URL=sqlite:///./annarakshak.db
# For Docker: DATABASE_URL=postgresql://annarakshak:annarakshak@postgres:5432/annarakshak

# JWT Secret (change in production!)
JWT_SECRET=annarakshak-prototype-secret-key-change-in-prod

# Redis
REDIS_URL=redis://localhost:6379/0

# File uploads
UPLOAD_DIR=./uploads
